# .ebextensions/eb-env.config
# Elastic Beanstalk environment settings for the Java (Corretto) platform.
# Place this file inside a .ebextensions/ folder at the project root before
# running `eb create` / `eb deploy`.

option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_HOST: "REPLACE_WITH_RDS_ENDPOINT_OUTPUT"
    DB_PORT: "1521"
    DB_SERVICE_NAME: "ORCL"
    DB_USERNAME: "fullreval_admin"
    # DB_PASSWORD should be set via `eb setenv DB_PASSWORD=...` or, better,
    # pulled from AWS Secrets Manager at startup — never commit it here.
    SERVER_PORT: "5000"          # EB's nginx proxy expects the app on 5000 by default

  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro

  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance   # no load balancer = cheaper, fine for a demo
